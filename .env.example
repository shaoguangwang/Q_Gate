# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# --- OpenAI API key ---
# Required for: the LLM gater (--strategy llm), the GPT-4o QA backend (--backend gpt4),
# and the grounding producer's entity extraction (Stage 1, score_logic).
OPENAI_API_KEY=

# Chat-completions endpoint. Leave unset to use the official OpenAI API.
# Set this to route through a proxy or a local OpenAI-compatible server, e.g.:
#   OPENAI_BASE_URL=https://<your-proxy>/v1/chat/completions
# OPENAI_BASE_URL=

# --- Local open-source VLM backends (OpenAI-compatible servers, e.g. vLLM) ---
# Only needed if you use --backend qwen3_32b / internvl3_8b / internvl_26b.
# QWEN3_32B_BASE_URL=http://localhost:8001/v1
# INTERNVL3_BASE_URL=http://localhost:8003/v1
# INTERNVL26B_BASE_URL=http://localhost:8002/v1

# --- Dataset roots (used by the QA pipeline and the narrative producer) ---
# Defaults are relative to the repo (./Datasets/...); override as needed.
# LVB_SUBTITLE_ROOT=./Datasets/LVBench/subtitles
# VIDEOMME_SUBTITLE_ROOT=./Datasets/Video-MME/subtitle
